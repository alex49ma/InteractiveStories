# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# --- Required ---

# SQLAlchemy connection string. Default is a local SQLite file.
DATABASE_URL=sqlite:///./database.db

# Google AI Studio key (https://aistudio.google.com/apikey),
# or "lm-studio" when pointing BASE_URL at a local LM Studio server.
GEMINI_API_KEY=

# --- Optional (defaults shown) ---

API_PREFIX=/api
DEBUG=False

# OpenAI-compatible endpoint used by the story generator.
BASE_URL="http://localhost:1234/v1"

# Comma-separated CORS origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
